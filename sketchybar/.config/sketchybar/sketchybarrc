#!/usr/bin/env bash

# Ayu Dark palette, matched to the rest of the setup
export BLACK=0xff0A0E14
export WHITE=0xffFFFFFF
export ORANGE=0xffFF8F40
export CYAN=0xff95E6CB
export GREEN=0xffAAD94C
export YELLOW=0xffFFEE99
export RED=0xffF28779
export PURPLE=0xffD2A6FF

# Unicode Icon definitions
CLOCK_ICON=$(printf '\xef\x80\x97')
CLOUD_ICON=$(printf '\xef\x83\x82')

PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# Bar appearance
sketchybar --bar \
  height=24 \
  color=$BLACK \
  position=top \
  padding_left=10 \
  padding_right=10 \
  corner_radius=0 \
  y_offset=0

# Global item defaults
sketchybar --default \
  icon.font="FiraCode Nerd Font:Bold:14.0" \
  icon.color=$WHITE \
  label.font="FiraCode Nerd Font:Semibold:13.0" \
  label.color=$WHITE \
  padding_left=5 \
  padding_right=5

# --- Left side: Yabai spaces + front app ---

for i in 1 2 3 4 5 6; do
  sketchybar --add space space.$i left \
             --set space.$i \
             associated_space=$i \
             icon=$i \
             icon.color=$CYAN \
             icon.padding_left=7 \
             icon.padding_right=7 \
	     padding_left=2 \
	     padding_right=2 \
             background.drawing=on \
             background.color=0x30ffffff \
             background.corner_radius=2 \
             background.height=24 \
             label.drawing=off \
             click_script="yabai -m space --focus $i" \
             script="$PLUGIN_DIR/space.sh $i" \
             --subscribe space.$i space_change
done

sketchybar --add item front_app left \
           --set front_app \
           icon.drawing=off \
           label.color=$ORANGE \
           script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# --- Right side: weather, battery, clock ---

sketchybar --add item clock right \
           --set clock \
           update_freq=10 \
           icon="$CLOCK_ICON" \
           icon.color=$PURPLE \
           script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
           --set battery \
           update_freq=60 \
           icon.color=$GREEN \
           script="$PLUGIN_DIR/battery.sh"

sketchybar --add item weather right \
           --set weather \
           update_freq=1800 \
           icon="$CLOUD_ICON" \
           icon.color=$YELLOW \
           script="$PLUGIN_DIR/weather.sh"

sketchybar --update

# --- Spawn the independent bottom bar ---
if ! pgrep -q bottom_bar; then
  bottom_bar &
fi
